    "Press and hold on a prayer’s words, then tap Add Note.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte die Wörter eines Gebets gedrückt und tippe dann auf „Notiz hinzufügen“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsadas las palabras de una oración y toca Añadir nota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez le doigt sur les mots d’une prière, puis touchez Ajouter une note."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto sulle parole di una preghiera, poi tocca Aggiungi nota."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd de woorden van een gebed ingedrukt en tik op Voeg notitie toe."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Haltu fingri á orðum bænar og ýttu svo á Bæta við athugasemd."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podržte prst na slovech modlitby a klepněte na Přidat poznámku."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Podržte prst na slovách modlitby a ťuknite na Pridať poznámku."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "روی کلمات یک دعا انگشت خود را نگه دارید، سپس «افزودن یادداشت» را بزنید."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مطولًا على كلمات الدعاء، ثم اضغط على «إضافة ملاحظة»."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પ્રાર્થનાના શબ્દો પર દબાવી રાખો, પછી નોંધ ઉમેરો પર ટૅપ કરો."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी प्रार्थना के शब्दों को दबाकर रखें, फिर नोट जोड़ें पर टैप करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan lama kata-kata doa, lalu ketuk Tambah Catatan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "祈りの言葉を長押しして、「メモを追加」をタップします。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ರಾರ್ಥನೆಯ ಪದಗಳನ್ನು ಒತ್ತಿ ಹಿಡಿದು, ನಂತರ ಟಿಪ್ಪಣಿ ಸೇರಿಸಿ ಟ್ಯಾಪ್ ಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기도문의 단어를 길게 누른 다음 메모 추가를 탭하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു പ്രാർത്ഥനയിലെ വാക്കുകളിൽ അമർത്തിപ്പിടിച്ച്, തുടർന്ന് കുറിപ്പ് ചേർക്കുക ടാപ്പ് ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रार्थनेतील शब्दांवर दाबून ठेवा, मग टीप जोडा वर टॅप करा."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପ୍ରାର୍ଥନାର ଶବ୍ଦ ଉପରେ ଦବାଇ ଧରନ୍ତୁ, ତାପରେ ଟିପ୍ପଣୀ ଯୋଡ଼ନ୍ତୁ ଟ୍ୟାପ୍ କରନ୍ତୁ।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha pressionadas as palavras de uma oração e toque em Adicionar Nota."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите и удерживайте слова молитвы, затем нажмите «Добавить заметку»."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பிரார்த்தனையின் சொற்களை அழுத்திப் பிடித்து, பின்னர் குறிப்பைச் சேர் என்பதைத் தட்டவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రార్థనలోని పదాలను నొక్కి పట్టుకుని, ఆపై గమనిక జోడించు నొక్కండి."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir duanın kelimelerine basılı tutun, sonra Not Ekle'ye dokunun."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کسی دعا کے الفاظ کو دبا کر رکھیں، پھر نوٹ شامل کریں پر ٹیپ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn giữ vào chữ của bài kinh, rồi chạm Thêm ghi chú."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住祷文中的文字，然后轻点“添加笔记”。"
          }
        }
      }
    },
