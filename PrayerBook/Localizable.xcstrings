    "I dedicate this app to my parents Bahman and Jalal, to the Iranian Bahá’í Community, and the Italian Bahá’í Community.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich widme diese App meinen Eltern Bahman und Jalal, der iranischen Bahá’í-Gemeinde und der italienischen Bahá’í-Gemeinde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dedico esta app a mis padres, Bahman y Jalal, a la comunidad bahá’í de Irán y a la comunidad bahá’í de Italia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je dédie cette app à mes parents, Bahman et Jalal, à la communauté bahá’íe d’Iran et à la communauté bahá’íe d’Italie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dedico questa app ai miei genitori, Bahman e Jalal, alla comunità bahá’í iraniana e alla comunità bahá’í italiana."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik draag deze app op aan mijn ouders Bahman en Jalal, aan de Iraanse bahá’í-gemeenschap en aan de Italiaanse bahá’í-gemeenschap."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ég tileinka foreldrum mínum, Bahman og Jalal, þetta forrit, og einnig íranska bahá’í-samfélaginu og ítalska bahá’í-samfélaginu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuto aplikaci věnuji svým rodičům Bahmanovi a Jalalovi, íránskému bahá’í společenství a italskému bahá’í společenství."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Túto aplikáciu venujem svojim rodičom Bahmanovi a Jalalovi, iránskemu bahá’í spoločenstvu a talianskemu bahá’í spoločenstvu."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این برنامه را به پدر و مادرم، بهمن و جلال، به جامعهٔ بهائی ایران و به جامعهٔ بهائی ایتالیا تقدیم می‌کنم."
          }
        }
      }
    },
