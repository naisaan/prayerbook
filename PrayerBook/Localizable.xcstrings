        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Bænirnar haldast í bókinni; aðeins þessum lista er eytt."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Modlitby v knize zůstanou; odstraní se jen tento seznam."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Modlitby v knihe zostanú; odstráni sa iba tento zoznam."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دعاها در کتاب می‌مانند؛ فقط این فهرست حذف می‌شود."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى الأدعية في الكتاب؛ وتُحذف هذه القائمة فقط."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પ્રાર્થનાઓ પુસ્તકમાં રહે છે; ફક્ત આ યાદી દૂર થાય છે."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रार्थनाएँ पुस्तक में बनी रहती हैं; केवल यह सूची हटाई जाती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Doa-doa tetap ada di buku; hanya daftar ini yang dihapus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "祈りは本に残り、このリストだけが削除されます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ರಾರ್ಥನೆಗಳು ಪುಸ್ತಕದಲ್ಲೇ ಇರುತ್ತವೆ; ಈ ಪಟ್ಟಿ ಮಾತ್ರ ತೆಗೆದುಹಾಕಲಾಗುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기도문은 책에 그대로 남고 이 목록만 삭제됩니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പ്രാർത്ഥനകൾ പുസ്തകത്തിൽ തന്നെ ഉണ്ടാകും; ഈ ലിസ്റ്റ് മാത്രമേ നീക്കം ചെയ്യൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रार्थना पुस्तकात राहतात; फक्त ही यादी काढली जाते."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପ୍ରାର୍ଥନାଗୁଡ଼ିକ ପୁସ୍ତକରେ ରହିବ; କେବଳ ଏହି ତାଲିକା ହଟାଯିବ।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As orações continuam no livro; apenas esta lista é removida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Молитвы остаются в книге; удаляется только этот список."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பிரார்த்தனைகள் புத்தகத்தில் இருக்கும்; இந்தப் பட்டியல் மட்டும் நீக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రార్థనలు పుస్తకంలోనే ఉంటాయి; ఈ జాబితా మాత్రమే తీసివేయబడుతుంది."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dualar kitapta kalır; yalnızca bu liste silinir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دعائیں کتاب میں رہتی ہیں؛ صرف یہ فہرست ہٹائی جاتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các bài kinh vẫn ở trong sách; chỉ danh sách này bị xóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "祷文仍保留在书中，只删除此列表。"
          }
        }
      }
    },
