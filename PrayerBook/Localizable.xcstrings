    "Start reading progress over?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lesefortschritt zurücksetzen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Reiniciar el progreso de lectura?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réinitialiser la progression de lecture ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Azzerare i progressi di lettura?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leesvoortgang opnieuw beginnen?"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Byrja lestrarframvindu upp á nýtt?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Začít postup čtení znovu?"
          }
        },
        "sk": {
