          "stringUnit": {
            "state": "translated",
            "value": "Cài đặt siêu bí mật"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "超级秘密设置"
          }
        }
      }
    },
    "Tap the circle each time you say “Alláh-u-Abhá”. Tap with three fingers for settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe jedes Mal auf den Kreis, wenn du „Alláh-u-Abhá“ sagst. Tippe mit drei Fingern für die Einstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el círculo cada vez que digas «Alláh-u-Abhá». Toca con tres dedos para ver los ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez le cercle chaque fois que vous dites « Alláh-u-Abhá ». Touchez avec trois doigts pour les réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca il cerchio ogni volta che dici «Alláh-u-Abhá». Tocca con tre dita per le impostazioni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op de cirkel telkens als je ‘Alláh-u-Abhá’ zegt. Tik met drie vingers voor de instellingen."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Pikkaðu á hringinn í hvert sinn sem þú segir „Alláh-u-Abhá“. Pikkaðu með þremur fingrum til að sjá stillingar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepněte na kruh pokaždé, když řeknete „Alláh-u-Abhá“. Klepnutím třemi prsty zobrazíte nastavení."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ťuknite na kruh zakaždým, keď poviete „Alláh-u-Abhá“. Ťuknutím troma prstami zobrazíte nastavenia."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هر بار که «الله‌ابهی» می‌گویید روی دایره ضربه بزنید. برای تنظیمات با سه انگشت ضربه بزنید."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على الدائرة في كل مرة تقول فيها «الله أبهى». اضغط بثلاثة أصابع لفتح الإعدادات."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "દરેક વાર “અલ્લાહ-ઉ-અબ્હા” બોલો ત્યારે વર્તુળ પર ટૅપ કરો. સેટિંગ્સ માટે ત્રણ આંગળીઓથી ટૅપ કરો."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर बार “अल्लाह-उ-अब्हा” कहने पर वृत्त पर टैप करें। सेटिंग्ज़ के लिए तीन उँगलियों से टैप करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk lingkaran setiap kali Anda mengucapkan “Alláh-u-Abhá”. Ketuk dengan tiga jari untuk pengaturan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「アッラーホ・アブハ」と唱えるたびに円をタップします。設定を開くには3本指でタップします。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ರತಿ ಬಾರಿ “ಅಲ್ಲಾಹ್-ಉ-ಅಬ್ಹಾ” ಎಂದಾಗ ವೃತ್ತವನ್ನು ಟ್ಯಾಪ್ ಮಾಡಿ. ಸೆಟ್ಟಿಂಗ್‌ಗಳಿಗಾಗಿ ಮೂರು ಬೆರಳುಗಳಿಂದ ಟ್ಯಾಪ್ ಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘알라후 아브하’라고 말할 때마다 원을 탭하세요. 설정을 열려면 세 손가락으로 탭하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓരോ തവണ “അല്ലാഹ്-ഉ-അബ്ഹാ” ചൊല്ലുമ്പോഴും വൃത്തത്തിൽ ടാപ്പ് ചെയ്യുക. ക്രമീകരണങ്ങൾക്ക് മൂന്ന് വിരലുകൾ കൊണ്ട് ടാപ്പ് ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येक वेळी “अल्लाह-उ-अब्हा” म्हणताना वर्तुळावर टॅप करा. सेटिंग्जसाठी तीन बोटांनी टॅप करा."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପ୍ରତ୍ୟେକ ଥର “ଅଲ୍ଲାହ୍-ଉ-ଅବହା” କହିବା ସମୟରେ ବୃତ୍ତଟି ଟ୍ୟାପ୍ କରନ୍ତୁ। ସେଟିଂସ୍ ପାଇଁ ତିନି ଆଙ୍ଗୁଠିରେ ଟ୍ୟାପ୍ କରନ୍ତୁ।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no círculo cada vez que disser “Alláh-u-Abhá”. Toque com três dedos para os ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажимайте на круг каждый раз, когда произносите «Аллах-у-Абха». Нажмите тремя пальцами, чтобы открыть настройки."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒவ்வொரு முறையும் “அல்லாஹ்-உ-அப்ஹா” என்று சொல்லும்போது வட்டத்தைத் தட்டவும். அமைப்புகளுக்கு மூன்று விரல்களால் தட்டவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రతిసారి “అల్లాహ్-ఉ-అభా” అన్నప్పుడు వృత్తాన్ని నొక్కండి. సెట్టింగ్‌ల కోసం మూడు వేళ్లతో నొక్కండి."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her “Allah-u Ebha” deyişinizde daireye dokunun. Ayarlar için üç parmakla dokunun."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر بار “اللہ ابہیٰ” کہنے پر دائرے پر ٹیپ کریں۔ ترتیبات کے لیے تین انگلیوں سے ٹیپ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm vào vòng tròn mỗi lần bạn đọc “Alláh-u-Abhá”. Chạm bằng ba ngón tay để mở cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每念一次“阿拉乌阿卜哈”就轻点一下圆圈。用三根手指轻点可打开设置。"
          }
        }
      }
    },
    "Tap this list’s bookmark button in the menu while reading to add a prayer.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe beim Lesen im Menü auf das Lesezeichen dieser Liste, um ein Gebet hinzuzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras lees, toca el marcador de esta lista en el menú para añadir una oración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendant la lecture, touchez le signet de cette liste dans le menu pour ajouter une prière."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante la lettura, tocca il segnalibro di questo elenco nel menu per aggiungere una preghiera."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik tijdens het lezen in het menu op de bladwijzer van deze lijst om een gebed toe te voegen."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ýttu á bókamerki þessa lista í valmyndinni meðan þú lest til að bæta við bæn."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při čtení klepněte v nabídce na záložku tohoto seznamu a přidejte modlitbu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri čítaní ťuknite v ponuke na záložku tohto zoznamu a pridajte modlitbu."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هنگام خواندن، در منو روی نشانک این فهرست بزنید تا دعایی اضافه شود."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أثناء القراءة، اضغط على زر الإشارة المرجعية لهذه القائمة في القائمة لإضافة دعاء."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "વાંચતી વખતે પ્રાર્થના ઉમેરવા માટે મેનૂમાં આ યાદીના બુકમાર્ક બટન પર ટૅપ કરો."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पढ़ते समय प्रार्थना जोड़ने के लिए मेनू में इस सूची के बुकमार्क बटन पर टैप करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat membaca, ketuk tombol penanda daftar ini di menu untuk menambahkan doa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読んでいるときにメニューでこのリストのブックマークボタンをタップすると、祈りを追加できます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಓದುವಾಗ ಪ್ರಾರ್ಥನೆಯನ್ನು ಸೇರಿಸಲು ಮೆನುವಿನಲ್ಲಿ ಈ ಪಟ್ಟಿಯ ಬುಕ್‌ಮಾರ್ಕ್ ಬಟನ್ ಟ್ಯಾಪ್ ಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽는 중에 메뉴에서 이 목록의 책갈피 버튼을 탭하면 기도문이 추가됩니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വായിക്കുമ്പോൾ ഒരു പ്രാർത്ഥന ചേർക്കാൻ, മെനുവിൽ ഈ ലിസ്റ്റിന്റെ ബുക്ക്മാർക്ക് ബട്ടൺ ടാപ്പ് ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "वाचताना प्रार्थना जोडण्यासाठी मेनूमधील या यादीच्या खूण बटणावर टॅप करा."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପଢ଼ିବା ସମୟରେ ପ୍ରାର୍ଥନା ଯୋଡ଼ିବାକୁ, ମେନୁରେ ଏହି ତାଲିକାର ବୁକମାର୍କ ବଟନ୍ ଟ୍ୟାପ୍ କରନ୍ତୁ।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante a leitura, toque no botão de marcador desta lista no menu para adicionar uma oração."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Во время чтения нажмите в меню кнопку закладки этого списка, чтобы добавить молитву."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "படிக்கும்போது பிரார்த்தனையைச் சேர்க்க, மெனுவில் இந்தப் பட்டியலின் புத்தகக்குறி பொத்தானைத் தட்டவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చదువుతున్నప్పుడు ప్రార్థనను జోడించడానికి మెనూలో ఈ జాబితా బుక్‌మార్క్ బటన్‌ను నొక్కండి."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Okurken bir dua eklemek için menüde bu listenin yer işareti düğmesine dokunun."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پڑھتے وقت دعا شامل کرنے کے لیے مینو میں اس فہرست کے بُک مارک بٹن پر ٹیپ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi đang đọc, chạm vào nút dấu trang của danh sách này trong menu để thêm một bài kinh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阅读时在菜单中轻点此列表的书签按钮，即可添加祷文。"
          }
        }
      }
    },
    "The book shows prayers in every language that's turned on, each with its own sections.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Buch zeigt Gebete in jeder eingeschalteten Sprache, jede mit eigenen Abschnitten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El libro muestra las oraciones en cada idioma activado, cada uno con sus propias secciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le livre affiche les prières dans chaque langue activée, chacune avec ses propres sections."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il libro mostra le preghiere in ogni lingua attivata, ciascuna con le sue sezioni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het boek toont gebeden in elke ingeschakelde taal, elk met eigen secties."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Bókin sýnir bænir á hverju tungumáli sem er kveikt á, hvert með sína eigin kafla."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kniha zobrazuje modlitby ve všech zapnutých jazycích, každý s vlastními oddíly."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kniha zobrazuje modlitby vo všetkých zapnutých jazykoch, každý s vlastnými časťami."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کتاب دعاها را به همهٔ زبان‌های روشن نشان می‌دهد و هر زبان بخش‌های خودش را دارد."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض الكتاب الأدعية بكل لغة مفعّلة، ولكل لغة أقسامها الخاصة."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પુસ્તક દરેક ચાલુ ભાષામાં પ્રાર્થનાઓ બતાવે છે, દરેક ભાષા તેના પોતાના વિભાગો સાથે."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पुस्तक हर चालू भाषा में प्रार्थनाएँ दिखाती है, हर भाषा के अपने खंडों के साथ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buku ini menampilkan doa dalam setiap bahasa yang aktif, masing-masing dengan bagiannya sendiri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンになっているすべての言語の祈りが、それぞれの章とともに本に表示されます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆನ್ ಆಗಿರುವ ಪ್ರತಿಯೊಂದು ಭಾಷೆಯ ಪ್ರಾರ್ಥನೆಗಳನ್ನು, ಅವುಗಳದೇ ವಿಭಾಗಗಳೊಂದಿಗೆ ಪುಸ್ತಕ ತೋರಿಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜져 있는 모든 언어의 기도문이 각자의 장과 함께 책에 표시됩니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓൺ ആക്കിയ ഓരോ ഭാഷയിലെയും പ്രാർത്ഥനകൾ, അവയുടെ സ്വന്തം വിഭാഗങ്ങളോടെ പുസ്തകം കാണിക്കുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पुस्तक प्रत्येक सुरू असलेल्या भाषेतील प्रार्थना त्यांच्या स्वतःच्या विभागांसह दाखवते."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଚାଲୁ ଥିବା ପ୍ରତ୍ୟେକ ଭାଷାର ପ୍ରାର୍ଥନାକୁ ପୁସ୍ତକ ସେଗୁଡ଼ିକର ନିଜ ବିଭାଗ ସହ ଦେଖାଏ।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O livro mostra as orações em todos os idiomas ativados, cada um com suas próprias seções."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Книга показывает молитвы на всех включённых языках, у каждого свои разделы."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இயக்கப்பட்ட ஒவ்வொரு மொழியிலும் உள்ள பிரார்த்தனைகளை, அவற்றின் சொந்தப் பிரிவுகளுடன் புத்தகம் காட்டுகிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆన్‌లో ఉన్న ప్రతి భాషలోని ప్రార్థనలను, వాటి సొంత విభాగాలతో పుస్తకం చూపిస్తుంది."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitap, açık olan her dildeki duaları kendi bölümleriyle gösterir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کتاب ہر فعال زبان میں دعائیں دکھاتی ہے، ہر زبان اپنے حصوں کے ساتھ۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sách hiển thị kinh nguyện bằng mọi ngôn ngữ đang bật, mỗi ngôn ngữ có các phần riêng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本书会显示所有已开启语言的祷文，每种语言都有自己的章节。"
          }
        }
      }
    },
    "The prayers stay in the book; only this list is removed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Gebete bleiben im Buch; nur diese Liste wird entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las oraciones permanecen en el libro; solo se elimina esta lista."
          }
        },
        "fr": {
          "stringUnit": {
