    "Open the menu while reading and tap the bookmark button to save a prayer.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne beim Lesen das Menü und tippe auf das Lesezeichen, um ein Gebet zu speichern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre el menú mientras lees y toca el botón de marcador para guardar una oración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez le menu pendant la lecture et touchez le bouton signet pour enregistrer une prière."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri il menu durante la lettura e tocca il pulsante segnalibro per salvare una preghiera."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open tijdens het lezen het menu en tik op de bladwijzerknop om een gebed te bewaren."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Opnaðu valmyndina meðan þú lest og ýttu á bókamerkjahnappinn til að vista bæn."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při čtení otevřete nabídku a klepnutím na tlačítko záložky modlitbu uložíte."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri čítaní otvorte ponuku a ťuknutím na tlačidlo záložky modlitbu uložíte."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هنگام خواندن منو را باز کنید و برای ذخیرهٔ دعا روی دکمهٔ نشانک بزنید."
          }
        }
      }
    },
