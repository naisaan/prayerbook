            "value": "Choisissez la couleur principale de votre perle de prière"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli il colore principale del tuo grano di preghiera"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies de hoofdkleur van je gebedskraal"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Veldu aðallit bænaperlunnar þinnar"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte hlavní barvu svého modlitebního korálku"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte hlavnú farbu svojho modlitebného korálika"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "رنگ اصلی دانهٔ تسبیح خود را انتخاب کنید"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر اللون الرئيسي لحبّة مسبحتك"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા પ્રાર્થના-મણકાનો મુખ્ય રંગ પસંદ કરો"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने प्रार्थना-मनके का मुख्य रंग चुनें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih warna utama manik doa Anda"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数珠の玉の主な色を選んでください"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಪ್ರಾರ್ಥನಾ ಮಣಿಯ ಮುಖ್ಯ ಬಣ್ಣವನ್ನು ಆರಿಸಿ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기도 구슬의 주 색상을 고르세요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ പ്രാർത്ഥനാ മുത്തുകളുടെ പ്രധാന നിറം തിരഞ്ഞെടുക്കുക"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या प्रार्थना-मण्याचा मुख्य रंग निवडा"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ ପ୍ରାର୍ଥନା ମାଳିର ମୁଖ୍ୟ ରଙ୍ଗ ବାଛନ୍ତୁ"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha a cor principal da sua conta de oração"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите основной цвет бусины"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் பிரார்த்தனை மணியின் முக்கிய நிறத்தைத் தேர்ந்தெடுக்கவும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ ప్రార్థనా పూస ప్రధాన రంగును ఎంచుకోండి"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tespih tanenizin ana rengini seçin"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنی تسبیح کے دانے کا بنیادی رنگ منتخب کریں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn màu chính cho hạt chuỗi của bạn"
          }
        },
