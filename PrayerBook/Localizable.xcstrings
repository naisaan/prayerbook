    "What do Bahá’ís Believe?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Woran glauben Bahá’í?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué creen los bahá’ís?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Que croient les bahá’ís ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In che cosa credono i bahá’í?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat geloven bahá’ís?"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hverju trúa bahá’íar?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čemu věří bahá’í?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Čomu veria bahá’í?"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بهائیان به چه باور دارند؟"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بماذا يؤمن البهائيون؟"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બહાઈઓ શું માને છે?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बहाई क्या मानते हैं?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang Diyakini Umat Bahá’í?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バハイは何を信じているのでしょう？"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಬಹಾಯಿಗಳು ಏನನ್ನು ನಂಬುತ್ತಾರೆ?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바하이는 무엇을 믿나요?"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ബഹായികൾ എന്ത് വിശ്വസിക്കുന്നു?"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "बहाई कशावर विश्वास ठेवतात?"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ବାହାଇମାନେ କ'ଣ ବିଶ୍ୱାସ କରନ୍ତି?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em que os Bahá’ís Acreditam?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Во что верят бахаи?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பஹாய்கள் எதை நம்புகிறார்கள்?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "బహాయిలు ఏమి నమ్ముతారు?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bahailer Neye İnanır?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بہائی کس بات پر ایمان رکھتے ہیں؟"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Người Bahá’í tin vào điều gì?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "巴哈伊信徒相信什么？"
          }
        }
      }
    },
    "What would you like to call this list?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie soll diese Liste heißen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cómo quieres llamar a esta lista?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel nom voulez-vous donner à cette liste ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come vuoi chiamare questo elenco?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe wil je deze lijst noemen?"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvað viltu kalla þennan lista?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak chcete tento seznam pojmenovat?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako chcete tento zoznam pomenovať?"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "می‌خواهید نام این فهرست چه باشد؟"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما الاسم الذي تريده لهذه القائمة؟"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ યાદીનું નામ શું રાખવું છે?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप इस सूची को क्या नाम देना चाहेंगे?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingin diberi nama apa daftar ini?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリストにどんな名前を付けますか？"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಪಟ್ಟಿಗೆ ಯಾವ ಹೆಸರು ಇಡಲು ಬಯಸುತ್ತೀರಿ?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 목록의 이름을 무엇으로 할까요?"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ലിസ്റ്റിന് എന്ത് പേരിടണം?"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या यादीला काय नाव द्यायचे?"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହି ତାଲିକାର ନାମ କ'ଣ ରଖିବାକୁ ଚାହାଁନ୍ତି?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Como você quer chamar esta lista?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как назвать этот список?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தப் பட்டியலுக்கு என்ன பெயர் வைக்க விரும்புகிறீர்கள்?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ జాబితాకు ఏ పేరు పెట్టాలనుకుంటున్నారు?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu listeye ne ad vermek istersiniz?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس فہرست کا کیا نام رکھنا چاہیں گے؟"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn muốn đặt tên danh sách này là gì?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你想给这个列表取什么名字？"
          }
        }
      }
    },
