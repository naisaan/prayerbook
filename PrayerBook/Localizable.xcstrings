    "All Bahá’í sacred writings copyright Bahá’í International Community.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle heiligen Bahá’í-Schriften: Copyright Bahá’í International Community."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los escritos sagrados bahá’ís: copyright Bahá’í International Community."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les écrits sacrés bahá’ís : copyright Bahá’í International Community."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti gli scritti sacri bahá’í: copyright Bahá’í International Community."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle heilige bahá’í-geschriften: copyright Bahá’í International Community."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Öll helg rit bahá’í: höfundarréttur Bahá’í International Community."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všechny posvátné bahá’í spisy: copyright Bahá’í International Community."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Všetky posvätné bahá’í spisy: copyright Bahá’í International Community."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حق نشر همهٔ آثار مقدس بهائی متعلق به جامعهٔ بین‌المللی بهائی است."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جميع الآثار البهائية المقدسة محفوظة الحقوق للجامعة البهائية العالمية."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બધાં બહાઈ પવિત્ર લખાણોનો કૉપિરાઇટ બહાઈ આંતરરાષ્ટ્રીય સમુદાય પાસે છે."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सभी बहाई पवित्र लेखों का कॉपीराइट बहाई अंतर्राष्ट्रीय समुदाय के पास है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hak cipta seluruh Tulisan Suci Bahá’í milik Komunitas Bahá’í Internasional."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バハイの聖典の著作権はすべてバハイ国際共同体に帰属します。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಎಲ್ಲಾ ಬಹಾಯಿ ಪವಿತ್ರ ಬರಹಗಳ ಹಕ್ಕುಸ್ವಾಮ್ಯ ಬಹಾಯಿ ಅಂತರರಾಷ್ಟ್ರೀಯ ಸಮುದಾಯಕ್ಕೆ ಸೇರಿದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 바하이 성스러운 글의 저작권은 바하이 국제 공동체에 있습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എല്ലാ ബഹായി വിശുദ്ധ ലിഖിതങ്ങളുടെയും പകർപ്പവകാശം ബഹായി അന്താരാഷ്ട്ര സമൂഹത്തിനാണ്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्व बहाई पवित्र लेखनांचा कॉपीराइट बहाई आंतरराष्ट्रीय समुदायाकडे आहे."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସମସ୍ତ ବାହାଇ ପବିତ୍ର ଲେଖାର ସ୍ୱତ୍ୱାଧିକାର ବାହାଇ ଆନ୍ତର୍ଜାତିକ ସମୁଦାୟର।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os escritos sagrados bahá’ís são protegidos por direitos autorais da Comunidade Internacional Bahá’í."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Авторские права на все священные писания бахаи принадлежат Международному сообществу бахаи."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அனைத்துப் பஹாய் புனித எழுத்துகளின் பதிப்புரிமை பஹாய் அனைத்துலகச் சமூகத்திற்குரியது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అన్ని బహాయి పవిత్ర రచనల కాపీరైట్ బహాయి అంతర్జాతీయ సమాజానిది."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm Bahai kutsal yazılarının telif hakkı Uluslararası Bahai Topluluğu'na aittir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تمام بہائی مقدس تحریروں کے جملہ حقوق بہائی بین الاقوامی کمیونٹی کے پاس ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi Thánh thư Bahá’í thuộc bản quyền của Cộng đồng Bahá’í Quốc tế."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有巴哈伊神圣经文的版权归巴哈伊国际社团所有。"
          }
        }
      }
    },
