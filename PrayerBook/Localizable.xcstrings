    "Your bookmarks and recent prayers are kept.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Lesezeichen und zuletzt gelesenen Gebete bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus marcadores y oraciones recientes se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos signets et prières récentes sont conservés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi segnalibri e le preghiere recenti vengono mantenuti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bladwijzers en recente gebeden blijven bewaard."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Bókamerki þín og nýlegar bænir haldast."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše záložky a nedávné modlitby zůstanou zachovány."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše záložky a nedávne modlitby zostanú zachované."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نشانک‌ها و دعاهای اخیر شما حفظ می‌شوند."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستبقى إشاراتك المرجعية والأدعية الأخيرة محفوظة."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા બુકમાર્ક અને તાજેતરની પ્રાર્થનાઓ સચવાઈ રહેશે."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके बुकमार्क और हाल की प्रार्थनाएँ बनी रहेंगी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penanda dan doa terakhir Anda tetap disimpan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブックマークと最近の祈りはそのまま残ります。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳು ಮತ್ತು ಇತ್ತೀಚಿನ ಪ್ರಾರ್ಥನೆಗಳು ಉಳಿಯುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "책갈피와 최근 기도문은 그대로 남습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ബുക്ക്മാർക്കുകളും സമീപകാല പ്രാർത്ഥനകളും സൂക്ഷിക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या खुणा आणि अलीकडील प्रार्थना जपल्या जातील."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ ବୁକମାର୍କ ଓ ସାମ୍ପ୍ରତିକ ପ୍ରାର୍ଥନା ରହିବ।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus marcadores e orações recentes serão mantidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши закладки и недавние молитвы сохранятся."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் புத்தகக்குறிகளும் சமீபத்திய பிரார்த்தனைகளும் வைக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ బుక్‌మార్క్‌లు, ఇటీవలి ప్రార్థనలు అలాగే ఉంటాయి."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yer işaretleriniz ve son okuduğunuz dualar korunur."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے بُک مارک اور حالیہ دعائیں محفوظ رہیں گی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dấu trang và các bài kinh gần đây của bạn vẫn được giữ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的书签和最近阅读的祷文会保留。"
          }
        }
      }
    },
